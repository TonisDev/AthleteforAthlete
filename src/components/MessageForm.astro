---
import { site } from '../lib/content';
import { ticketApi } from '../lib/site';

const form = site.message;
---

<form id="message-form" class="reserve-form" action={ticketApi} method="post" accept-charset="utf-8" data-fail={form.fail} data-either={form.either}>
  <input type="hidden" name="intent" value="message" />
  <div class="fields">
    <div class="field">
      <label for="message-name">{form.name}</label>
      <input id="message-name" name="name" type="text" autocomplete="name" maxlength="80" required />
    </div>
    <div class="field">
      <label for="message-phone">{form.phone}</label>
      <input id="message-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder={site.form.phonePlaceholder} />
    </div>
    <div class="field field-wide">
      <label for="message-email">{form.email}</label>
      <input id="message-email" name="email" type="email" autocomplete="email" maxlength="120" />
    </div>
    <div class="field field-wide">
      <label for="message">{form.body}</label>
      <textarea id="message" name="message" maxlength="1000" placeholder={form.bodyPlaceholder} required></textarea>
    </div>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="message-company">Εταιρεία</label>
    <input id="message-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="button" type="submit">{form.submit}</button>
  <p class="form-status" data-status role="status"></p>
  <p class="privacy">{form.either} {form.privacy}</p>
</form>

<script>
  const form = document.querySelector('#message-form');
  if (form instanceof HTMLFormElement && form.dataset.ready !== 'true') {
    form.dataset.ready = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      const status = form.querySelector('[data-status]');
      if (!(status instanceof HTMLElement)) return;

      status.textContent = '';
      status.classList.remove('is-ok', 'is-bad');
      const data = new FormData(form);
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      if (!phone && !email) {
        status.textContent = form.dataset.either || '';
        status.classList.add('is-bad');
        return;
      }
      if (button instanceof HTMLButtonElement) button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { accept: 'application/json' },
        });
        const payload = (await response.json()) as { ok?: boolean; message?: string };
        status.textContent = payload.message || form.dataset.fail || '';
        status.classList.add(payload.ok ? 'is-ok' : 'is-bad');
        if (payload.ok) form.reset();
      } catch {
        status.textContent = form.dataset.fail || '';
        status.classList.add('is-bad');
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
