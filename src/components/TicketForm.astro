---
import { event } from '../lib/content';
import { phoneHref } from '../lib/format';
import { ticketApi } from '../lib/site';
---

<form id="ticket-form" class="reserve-form" action={ticketApi} method="post" accept-charset="utf-8">
  <div class="fields">
    <div class="field">
      <label for="name">Όνομα</label>
      <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
    </div>
    <div class="field">
      <label for="phone">Τηλέφωνο</label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="69xxxxxxxx" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" maxlength="120" required />
    </div>
    <div class="field">
      <label for="area">Περιοχή</label>
      <input id="area" name="area" type="text" autocomplete="address-level2" maxlength="80" placeholder="π.χ. Καλαμαριά" required />
    </div>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="company">Εταιρεία</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="button" type="submit">Στείλε τα στοιχεία</button>
  <p class="form-status" data-status role="status"></p>
  <p class="privacy">
    Τα στοιχεία χρησιμοποιούνται μόνο για την επικοινωνία σχετικά με τα εισιτήρια αυτής της βραδιάς.
    Αν προτιμάς, πάρε μας στο <a href={phoneHref(event.phone)}>{event.phoneDisplay}</a>
    ή στείλε στο <a href={`mailto:${event.email}`}>{event.email}</a>.
  </p>
</form>

<script>
  const form = document.querySelector('#ticket-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      const status = form.querySelector('[data-status]');
      if (!(status instanceof HTMLElement)) return;

      status.textContent = '';
      status.classList.remove('is-ok', 'is-bad');
      if (button instanceof HTMLButtonElement) button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const payload = (await response.json()) as { ok?: boolean; message?: string };
        status.textContent = payload.message || 'Κάτι πήγε στραβά. Δοκίμασε ξανά.';
        status.classList.add(payload.ok ? 'is-ok' : 'is-bad');
        if (payload.ok) form.reset();
      } catch {
        status.textContent = 'Δεν στάλθηκε. Πάρε μας τηλέφωνο.';
        status.classList.add('is-bad');
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
