---
import { site } from '../lib/content';
import { ticketApi } from '../lib/site';

const form = site.form;
---

<form id="ticket-form" class="reserve-form" action={ticketApi} method="post" accept-charset="utf-8" data-fail={form.fail} data-either={form.either}>
  <input type="hidden" name="intent" value="tickets" />
  <div class="fields">
    <div class="field">
      <label for="name">{form.name}</label>
      <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
    </div>
    <div class="field">
      <label for="phone">{form.phone}</label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder={form.phonePlaceholder} />
    </div>
    <div class="field">
      <label for="email">{form.email}</label>
      <input id="email" name="email" type="email" autocomplete="email" maxlength="120" />
    </div>
    <div class="field">
      <label for="area">{form.area}</label>
      <input id="area" name="area" type="text" autocomplete="address-level2" maxlength="80" placeholder={form.areaPlaceholder} required />
    </div>
    <div class="field">
      <label for="count">{form.count}</label>
      <input id="count" name="count" type="number" inputmode="numeric" min="1" max={form.countMax} value="1" required />
    </div>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="company">Εταιρεία</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="button" type="submit">{form.submit}</button>
  <p class="form-status" data-status role="status"></p>
  <p class="privacy">{form.either} {form.privacy}</p>
</form>

<script>
  const form = document.querySelector('#ticket-form');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      const status = form.querySelector('[data-status]');
      if (!(status instanceof HTMLElement)) return;

      status.textContent = '';
      status.classList.remove('is-ok', 'is-bad');
      const data = new FormData(form);
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      if (!phone && !email) {
        status.textContent = form.dataset.either || '';
        status.classList.add('is-bad');
        return;
      }
      if (button instanceof HTMLButtonElement) button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { accept: 'application/json' },
        });
        const payload = (await response.json()) as { ok?: boolean; message?: string };
        status.textContent = payload.message || form.dataset.fail || '';
        status.classList.add(payload.ok ? 'is-ok' : 'is-bad');
        if (payload.ok) form.reset();
      } catch {
        status.textContent = form.dataset.fail || '';
        status.classList.add('is-bad');
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
