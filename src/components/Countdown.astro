---
import { site, startsAt } from '../lib/content';
import { pad, remainingParts } from '../lib/format';

const parts = remainingParts(startsAt);
const labels = site.countdown;
---

<div class:list={['countdown', { 'is-done': parts.done }]} data-countdown={startsAt} data-done={labels.done} style={`--wash:${site.look.countdownWash}`}>
  {
    parts.done ? (
      labels.done
    ) : (
      <>
        <p class="kicker">{labels.label}</p>
        <div class="countdown-grid">
          <div>
            <b data-days>{pad(parts.days)}</b>
            <span>{labels.days}</span>
          </div>
          <div>
            <b data-hours>{pad(parts.hours)}</b>
            <span>{labels.hours}</span>
          </div>
          <div>
            <b data-minutes>{pad(parts.minutes)}</b>
            <span>{labels.minutes}</span>
          </div>
          <div>
            <b data-seconds>{pad(parts.seconds)}</b>
            <span>{labels.seconds}</span>
          </div>
        </div>
      </>
    )
  }
</div>

<script>
  function pad(value: number) {
    return String(value).padStart(2, '0');
  }

  document.querySelectorAll('[data-countdown]').forEach((node) => {
    if (!(node instanceof HTMLElement) || node.dataset.ready === 'true') return;
    node.dataset.ready = 'true';
    const deadline = node.dataset.countdown;
    if (!deadline) return;
    const end = new Date(deadline).getTime();

    let timer = 0;
    const tick = () => {
      const diff = end - Date.now();
      if (diff <= 0) {
        window.clearInterval(timer);
        node.classList.add('is-done');
        node.textContent = node.dataset.done || '';
        return;
      }
      const total = Math.floor(diff / 1000);
      const days = node.querySelector('[data-days]');
      const hours = node.querySelector('[data-hours]');
      const minutes = node.querySelector('[data-minutes]');
      const seconds = node.querySelector('[data-seconds]');
      if (days) days.textContent = pad(Math.floor(total / 86400));
      if (hours) hours.textContent = pad(Math.floor((total % 86400) / 3600));
      if (minutes) minutes.textContent = pad(Math.floor((total % 3600) / 60));
      if (seconds) seconds.textContent = pad(total % 60);
    };

    tick();
    if (end > Date.now()) timer = window.setInterval(tick, 1000);
  });
</script>
