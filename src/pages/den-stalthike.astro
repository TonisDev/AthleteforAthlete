---
import Base from '../layouts/Base.astro';
import { site } from '../lib/content';
import { basePath } from '../lib/site';
---

<Base title={`${site.notices.failedTitle} — ${site.title}`} description={site.notices.failedText}>
  <main class="closure">
    <span class="mark" aria-hidden="true"></span>
    <p class="kicker">{site.title}</p>
    <h1>{site.notices.failedTitle}</h1>
    <p>{site.notices.failedText}</p>
    <a class="button" href={`${basePath}#${site.blocks.tickets.id}`}>{site.labels.backToForm}</a>
  </main>
</Base>
