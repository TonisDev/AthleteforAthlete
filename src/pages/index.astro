---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Marquee from '../components/Marquee.astro';
import NameList from '../components/NameList.astro';
import MessageForm from '../components/MessageForm.astro';
import Surface from '../components/Surface.astro';
import TicketForm from '../components/TicketForm.astro';
import { site, startsAt } from '../lib/content';
import { formatDay, formatEuros, formatTime, formatWeekday, phoneHref, reachableEmail, reachablePhone } from '../lib/format';
import { assetPath } from '../lib/site';

const sold = Math.max(0, site.ticketsSold);
const goal = Math.max(0, site.ticketGoal);
const raised = sold * site.ticketPrice;
const progress = goal > 0 ? Math.min(100, Math.round((sold / goal) * 100)) : 0;
const when = `${formatWeekday(startsAt)}, ${formatTime(startsAt)}`;
const phone = reachablePhone(site.contact.phone) ? phoneHref(site.contact.phone) : '';
const email = reachableEmail(site.contact.email) ? site.contact.email : '';
---

<Base title={site.title} description={site.description}>
  <Surface name="hero">
  <header class="mast wrap">
    <nav aria-label={site.labels.nav}>
      {site.nav.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
    </nav>
  </header>

  <div class="hero wrap">
    <div class="hero-copy">
      <h1>
        <span class="line">{site.hero.lineStart}</span>
        <span class="for">{site.hero.bridge}</span>
        <span class="line">{site.hero.lineEnd}</span>
      </h1>
      {site.hero.lede && <p class="lede">{site.hero.lede}</p>}
      <div class="organizers" id={site.blocks.organizers.id}>
        {site.blocks.organizers.kicker && <p class="kicker">{site.blocks.organizers.kicker}</p>}
        {site.blocks.organizers.title && <h2>{site.blocks.organizers.title}</h2>}
        <NameList items={site.organizers} />
        {site.blocks.organizers.text && <p class="text">{site.blocks.organizers.text}</p>}
      </div>
    </div>
    <div class="hero-side">
      <Countdown />
      <p class="when">{when}</p>
      <p class="where">«{site.venue}»</p>
      <p class="where-sub">
        {site.city}{site.address ? ` · ${site.address}` : ''}
      </p>
    </div>
    <a class="button hero-cta" href={`#${site.blocks.tickets.id}`}>
      <span class="price-tag">{formatEuros(site.ticketPrice)}</span>
      {site.hero.cta}
    </a>
  </div>
  </Surface>

  <Surface name="athletes" class="band anchor" id={site.blocks.athletes.id} labelledby={site.blocks.athletes.title ? 'athletes-heading' : undefined}>
    <div class="wrap band-head">
      {site.blocks.athletes.kicker && <p class="kicker">{site.blocks.athletes.kicker}</p>}
      {site.blocks.athletes.title && <h2 id="athletes-heading">{site.blocks.athletes.title}</h2>}
      {site.blocks.athletes.text && <p class="text">{site.blocks.athletes.text}</p>}
    </div>
    <Marquee empty={site.blocks.athletes.empty} />
  </Surface>

  <Surface name="clubs" class="band anchor" id={site.blocks.clubs.id}>
    <div class="wrap">
      {site.blocks.clubs.kicker && <p class="kicker">{site.blocks.clubs.kicker}</p>}
      {site.blocks.clubs.title && <h2>{site.blocks.clubs.title}</h2>}
      {site.blocks.clubs.text && <p class="text">{site.blocks.clubs.text}</p>}
      {site.clubs.length > 0 ? <NameList items={site.clubs} /> : <p class="empty">{site.blocks.clubs.empty}</p>}
    </div>
  </Surface>

  <div class="lane" aria-hidden="true"></div>

  <Surface name="transparency" class="block anchor" id={site.blocks.transparency.id}>
    <div class="wrap">
      {site.blocks.transparency.kicker && <p class="kicker">{site.blocks.transparency.kicker}</p>}
      {site.blocks.transparency.title && <h2>{site.blocks.transparency.title}</h2>}
      {site.blocks.transparency.text && <p class="text">{site.blocks.transparency.text}</p>}
      <ul class="stats">
        <li>
          <b>{new Intl.NumberFormat('el-GR').format(sold)}</b>
          <span>{site.stats.sold}</span>
        </li>
        <li>
          <b>{formatEuros(raised)}</b>
          <span>{site.stats.raised}</span>
        </li>
        <li>
          <b>{goal > 0 ? new Intl.NumberFormat('el-GR').format(goal) : '—'}</b>
          <span>{site.stats.goal}</span>
        </li>
      </ul>
      {
        goal > 0 && (
          <div class="meter" role="img" aria-label={`${sold} από ${goal} ${site.stats.sold}, ${progress}%`}>
            <div class="meter-fill" style={`width: ${progress}%`} />
          </div>
        )
      }
      {site.ticketsUpdatedAt && <p class="fine">{site.stats.updated}: {formatDay(site.ticketsUpdatedAt)}.</p>}
    </div>
  </Surface>

  <Surface name="tickets" class="block anchor" id={site.blocks.tickets.id}>
    <div class="wrap">
      <div class="reserve">
        <div>
          {site.blocks.tickets.kicker && <p class="kicker">{site.blocks.tickets.kicker}</p>}
          {site.blocks.tickets.title && <h2>{site.blocks.tickets.title}</h2>}
          {site.blocks.tickets.text && <p class="text">{site.blocks.tickets.text}</p>}
          <p class="fine venue-line">
            «{site.venue}» · {when}
            {site.address ? ` · ${site.address}` : ''}
          </p>
          {
            site.mapUrl && (
              <a class="text-link" href={site.mapUrl}>
                {site.labels.map}
              </a>
            )
          }
          {
            site.salePoints.length > 0 ? (
              <ul class="points">
                {site.salePoints.map((point) => (
                  <li>
                    <strong>{point.name}</strong>
                    {point.area ? <span>{point.area}</span> : null}
                    {point.address ? <span>{point.address}</span> : null}
                    {point.hours ? <span>{point.hours}</span> : null}
                    {point.mapUrl ? <a href={point.mapUrl}>{site.labels.map}</a> : null}
                  </li>
                ))}
              </ul>
            ) : (
              site.blocks.tickets.empty && <p class="empty">{site.blocks.tickets.empty}</p>
            )
          }
        </div>
        <TicketForm />
      </div>
    </div>
  </Surface>

  <Surface name="sponsors" class="block anchor" id={site.blocks.sponsors.id}>
    <div class="wrap">
      {site.blocks.sponsors.kicker && <p class="kicker">{site.blocks.sponsors.kicker}</p>}
      {
        site.sponsors.length > 0 && (
          <>
            {site.blocks.sponsors.title && <h2>{site.blocks.sponsors.title}</h2>}
            {site.blocks.sponsors.text && <p class="text">{site.blocks.sponsors.text}</p>}
            <ul class="sponsors">
              {site.sponsors.map((sponsor) => {
                const inner = (
                  <>
                    {sponsor.logo ? <img src={assetPath(sponsor.logo)} alt="" /> : null}
                    <span>
                      <span class="sponsor-name">{sponsor.name}</span>
                      {sponsor.offer ? <small>{sponsor.offer}</small> : null}
                    </span>
                  </>
                );
                return (
                  <li class={`is-${sponsor.size}`}>
                    {sponsor.url ? (
                      <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
                        {inner}
                      </a>
                    ) : (
                      <span>{inner}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </>
        )
      }
      {site.blocks.sponsors.askTitle && <h2 class="ask-title">{site.blocks.sponsors.askTitle}</h2>}
      {site.blocks.sponsors.askText && <p class="text">{site.blocks.sponsors.askText}</p>}
      <a class="button" href="#message">{site.labels.sponsorCta}</a>
    </div>
  </Surface>

  <Surface name="contact" class="block anchor" id={site.blocks.contact.id}>
    <div class="wrap">
      {site.blocks.contact.kicker && <p class="kicker">{site.blocks.contact.kicker}</p>}
      {site.blocks.contact.title && <h2>{site.blocks.contact.title}</h2>}
      {site.blocks.contact.text && <p class="text">{site.blocks.contact.text}</p>}
      {
        (phone || email) && (
          <ul class="contact-list">
            {phone && (
              <li>
                <span>{site.labels.phone}</span>
                <a href={phone}>{site.contact.phoneDisplay || site.contact.phone}</a>
              </li>
            )}
            {email && (
              <li>
                <span>{site.labels.email}</span>
                <a href={`mailto:${email}`}>{site.contact.email}</a>
              </li>
            )}
          </ul>
        )
      }
      <div class="reserve">
        <MessageForm />
      </div>
      <footer class="footer">
        <p>{site.organizers.map((person) => person.name).join(' · ')}</p>
      </footer>
    </div>
  </Surface>
</Base>
