---
import Base from '../layouts/Base.astro';
import { site } from '../lib/content';
import { basePath } from '../lib/site';
---

<Base title={`${site.notices.thanksTitle} — ${site.title}`} description={site.notices.thanksText}>
  <main class="closure">
    <span class="mark" aria-hidden="true"></span>
    <p class="kicker">{site.title}</p>
    <h1>{site.notices.thanksTitle}</h1>
    <p>{site.notices.thanksText}</p>
    <a class="button" href={basePath}>{site.labels.back}</a>
  </main>
</Base>
